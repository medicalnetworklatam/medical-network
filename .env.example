# Settings for the connection to Supabase.
#
# On your PC: copy this file to .env.local (same folder), fill in the two
# values from Supabase (Project Settings -> API Keys / Data API), then restart
# `npm run dev`. Git never commits .env.local.
#
# On Cloudflare Pages: add the same two names under the project's
# Settings -> Variables and Secrets, for Production and for Preview, then
# redeploy.
#
# Only the PUBLISHABLE key (sb_publishable_...) or the old anon key goes here.
# Never the secret / service-role key: everything named VITE_... becomes
# readable in the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
